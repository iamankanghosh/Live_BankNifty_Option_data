{
    "manifest_version": 3,
    "name": "NSE Nifty 50 & Gold",
    "version": "1.1",
    "description": "Get live Nifty 50, Gold 24K/22K, and Gold ETF prices",
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png",
        "options": {
            "type": "popup",
            "width": 400,
            "height": 420
        }
    },
    "icons": {
        "48": "icon.png"
    },
    "permissions": [
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "http://localhost:4500/*",
        "https://appfeeds.moneycontrol.com/",
        "https://live-banknifty-option-data.onrender.com/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    }
}